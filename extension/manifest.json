{
  "manifest_version": 3,
  "name": "Sahibinden Tutarsızlık Dedektörü",
  "version": "2.0.0",
  "description": "Başlığında hatasız/boyasız yazan ama açıklamasında boya, değişen parça veya hasar kaydı geçen ilanları işaretler.",

  "minimum_chrome_version": "102",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "Tutarsızlık Dedektörü",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "permissions": ["storage"],

  "host_permissions": [
    "https://www.sahibinden.com/*",
    "https://sahibinden.com/*"
  ],

  "background": {
    "service_worker": "src/background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.sahibinden.com/*",
        "https://sahibinden.com/*"
      ],
      "js": [
        "src/detector.js",
        "src/site-adapters.js",
        "src/content-core.js",
        "src/content-glue.js"
      ],
      "css": ["src/styles.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
